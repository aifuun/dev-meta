---
import { getCollection, render } from 'astro:content'
import { extractBody } from '../lib/html'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  const htmlRaw = import.meta.glob('../../content/**/*.html', {
    query: '?raw',
    import: 'default',
    eager: true,
  }) as Record<string, string>

  return [
    ...docs.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: 'doc' as const, entry },
    })),
    ...Object.entries(htmlRaw).map(([key, raw]) => ({
      params: { slug: key.replace(/^.*content\//, '').replace(/\.html$/, '') },
      props: { kind: 'html' as const, body: extractBody(raw) },
    })),
  ]
}

const props = Astro.props as
  | { kind: 'doc'; entry: Awaited<ReturnType<typeof getCollection>>[number] }
  | { kind: 'html'; body: string }

const rawBase = import.meta.env.BASE_URL
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`

let Content: any = null
let title = Astro.params.slug ?? ''

if (props.kind === 'doc') {
  const rendered = await render(props.entry)
  Content = rendered.Content
  title = props.entry.data.title ?? props.entry.id
} else {
  title = String(Astro.params.slug ?? '').split('/').pop() ?? ''
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem 4rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
        line-height: 1.7;
      }
      nav { margin-bottom: 1.5rem; font-size: 14px; }
      a { color: #0969da; text-decoration: none; }
      a:hover { text-decoration: underline; }
      pre { background: rgba(175,184,193,.2); padding: 1rem; border-radius: 8px; overflow-x: auto; }
      code { background: rgba(175,184,193,.2); padding: .2em .4em; border-radius: 6px; font-size: 85%; }
      pre code { background: none; padding: 0; }
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 1px solid #d0d7de; padding: .5rem .75rem; text-align: left; }
      th { background: rgba(175,184,193,.2); }
    </style>
  </head>
  <body>
    <nav><a href={base}>← 返回索引</a></nav>
    <main>
      {props.kind === 'doc' ? <Content /> : <Fragment set:html={props.body} />}
    </main>
  </body>
</html>
