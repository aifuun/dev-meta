---
import { getCollection } from 'astro:content'
import DirTree from '../components/DirTree.astro'
import { buildTree, type Leaf } from '../lib/tree'

// BASE_URL 是否带尾斜杠取决于 astro.config 的 base 写法，此处统一补齐
const rawBase = import.meta.env.BASE_URL
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`

const docs = await getCollection('docs')
const htmlRaw = import.meta.glob('../../content/**/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>

const leaves: Leaf[] = [
  ...docs.map((e) => ({
    slug: e.id,
    title: e.data.title ?? e.id,
    href: `${base}${e.id}`,
  })),
  ...Object.keys(htmlRaw).map((k) => {
    const slug = k.replace(/^.*content\//, '').replace(/\.html$/, '')
    return {
      slug,
      title: e2title(slug),
      href: `${base}${slug}`,
    }
  }),
]

function e2title(slug: string) {
  return slug.split('/').pop() ?? slug
}

const tree = buildTree(leaves)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>内容索引</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem 4rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
        line-height: 1.7;
      }
      h1 { border-bottom: 2px solid #d0d7de; padding-bottom: .3em; }
      .meta { color: #57606a; font-size: 14px; }
      ul.tree { list-style: none; padding-left: 1rem; margin: .3rem 0; }
      ul.tree ul.tree { border-left: 1px solid #d0d7de; margin-left: .2rem; }
      summary { cursor: pointer; font-weight: 600; padding: .15rem 0; }
      a { color: #0969da; text-decoration: none; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <h1>内容索引</h1>
    <p class="meta">共 {leaves.length} 个文件，按目录分类。</p>
    <DirTree nodes={tree} />
  </body>
</html>
